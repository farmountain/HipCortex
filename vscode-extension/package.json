{
    "name": "hipcortex-memory",
    "displayName": "HipCortex Memory Engine & Cognitive OS",
    "description": "Persistent causal topological memory, world model prediction (/worldmodel/rollout), and Headroom token optimization (59-88% savings) for Copilot & Antigravity IDE.",
    "version": "0.5.5",
    "publisher": "farmountain",
  "repository": {
    "type": "git",
    "url": "https://github.com/farmountain/HipCortex.git"
  },
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": ["Machine Learning", "Data Science", "Other"],
    "icon": "icon.png",
    "keywords": ["memory", "causal", "cognitive-os", "copilot", "antigravity", "mcp", "ai", "agent", "topological", "world-model"],
    "main": "./dist/extension.js",
    "files": [
        "dist",
        "server",
        "icon.png"
    ],
    "contributes": {
        "commands": [
            {
                "command": "hipcortex.addMemory",
                "title": "Add Memory Record",
                "category": "HipCortex"
            },
            {
                "command": "hipcortex.queryMemory", 
                "title": "Query Memory Records",
                "category": "HipCortex"
            },
            {
                "command": "hipcortex.testExtension",
                "title": "Test HipCortex Extension",
                "category": "HipCortex"
            },
            {
                "command": "hipcortex.healthCheck",
                "title": "System Health Check",
                "category": "HipCortex"
            },
            {
                "command": "hipcortex.predictState",
                "title": "Predict Next State",
                "category": "HipCortex"
            },
            {
                "command": "hipcortex.restartServer",
                "title": "Restart HipCortex Server",
                "category": "HipCortex"
            }
        ],
        "chatParticipants": [
            {
                "id": "hipcortex",
                "name": "HipCortex",
                "description": "HipCortex AI Memory Assistant - Official Extension",
                "isSticky": true,
                "commands": [
                    {
                        "name": "add",
                        "description": "Add a new memory record"
                    },
                    {
                        "name": "query", 
                        "description": "Search memory records"
                    },
                    {
                        "name": "health",
                        "description": "Check system health"
                    },
                    {
                        "name": "help",
                        "description": "Show help information"
                    },
                    {
                        "name": "predict",
                        "description": "Predict next state using world-model"
                    },
                    {
                        "name": "coherence",
                        "description": "Check memory coherence"
                    },
                    {
                        "name": "link",
                        "description": "Link two memory records: @hipcortex /link <source-id> <target-id> [relation]"
                    },
                    {
                        "name": "mode",
                        "description": "Switch token optimization mode: @hipcortex /mode <headroom|caveman>"
                    }
                ]
            }
        ],
        "configuration": {
            "title": "HipCortex Memory",
            "properties": {
                "hipcortex.optimizationMode": {
                    "type": "string",
                    "enum": ["headroom", "caveman"],
                    "default": "headroom",
                    "description": "Token optimization retrieval depth mode: headroom (Top-5, 59-84% savings) or caveman (Top-3, 70-88% savings)."
                }
            }
        },
        "languageModelTools": [
            {
                "name": "hipcortex_search",
                "displayName": "HipCortex Memory Search",
                "description": "Search HipCortex persistent memory for relevant context. Returns the most relevant memory records matching the query.",
                "modelDescription": "Use this FIRST for any recall. Returns unified live_beliefs (memory + world model + hypotheses + coherence). Call before asking the user.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "query": {
                            "type": "string",
                            "description": "What to search for in memory"
                        }
                    },
                    "required": ["query"]
                }
            },
            {
                "name": "hipcortex_health",
                "displayName": "HipCortex System Health",
                "description": "Check HipCortex system health including self-model, world-model, and coherence status.",
                "modelDescription": "Use this FIRST for health/status before other actions. Returns substrate health + world model coherence.",
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "required": []
                }
            },
            {
                "name": "hipcortex_predict",
                "displayName": "HipCortex State Prediction",
                "description": "Predict next state using the world-model's Dirichlet-Multinomial transition model.",
                "modelDescription": "Use this FIRST for world model predictions. Call substrate predict before deciding actions. Returns WM + uncertainty.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "state": { "type": "string", "description": "Current state" },
                        "action": { "type": "string", "description": "Action being taken" }
                    },
                    "required": ["state", "action"]
                }
            },
            {
                "name": "hipcortex_graph_search",
                "displayName": "HipCortex Graph Search",
                "description": "PPR-ranked related memory search via CausalTopoGraph. Given a seed memory record ID, returns the most contextually relevant related memories using Personalized PageRank.",
                "modelDescription": "Use this AFTER hipcortex_search to expand context graph-first. Call with a seed_id (record UUID) to find memories linked via the CausalTopoGraph using PPR (alpha=0.85, 20 rounds).",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "seed_id": {
                            "type": "string",
                            "description": "UUID of the seed memory record to personalise PPR from"
                        },
                        "limit": {
                            "type": "number",
                            "description": "Max results to return (default: 10)"
                        }
                    },
                    "required": ["seed_id"]
                }
            }
        ],
        "configuration": {
            "title": "HipCortex Memory",
            "properties": {
                "hipcortex.apiUrl": {
                    "type": "string",
                    "default": "http://127.0.0.1:3030",
                    "description": "HipCortex API server URL"
                },
                "hipcortex.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "API key for authentication (if required)"
                },
                "hipcortex.autoStart": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically start HipCortex server if not running"
                },
                "hipcortex.strictServerVersion": {
                    "type": "boolean",
                    "default": false,
                    "description": "When true, only reuse a local server if /health.version exactly matches the expected crate/server binary version. When false (default), reuse any healthy server with same major.minor (or missing version field)."
                }
            }
        }
    },
    "activationEvents": [
        "onStartupFinished",
        "onCommand:workbench.action.chat.open"
    ],
    "scripts": {
        "vscode:prepublish": "npm run package",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "webpack --mode production --devtool hidden-source-map",
        "fetch-bins": "node scripts/fetch-bins.js",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "jest --config jest.config.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.90.0",
        "@types/jest": "^29.5.12",
        "@types/node": "20.x",
        "jest": "^29.7.0",
        "ts-jest": "^29.2.5",
        "@typescript-eslint/eslint-plugin": "^6.13.1",
        "@typescript-eslint/parser": "^6.13.1",
        "eslint": "^8.54.0",
        "typescript": "^5.3.2",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4",
        "ts-loader": "^9.5.1"
    },
    "dependencies": {
        "axios": "^1.6.2"
    }
}
