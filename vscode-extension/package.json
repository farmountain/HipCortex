{
    "name": "hipcortex-memory",
    "displayName": "HipCortex Memory Integration",
    "description": "HipCortex — Persistent AI memory with metacognitive intelligence. Search, health check, predictions.",
    "version": "0.2.0",
    "publisher": "farmountain",
    "engines": {
        "vscode": "^1.90.0"
    },
    "categories": ["Machine Learning", "Data Science", "Other"],
    "keywords": ["ai", "memory", "agent", "chat", "hipcortex"],
    "main": "./dist/extension.js",
    "contributes": {
        "commands": [
            {
                "command": "hipcortex.addMemory",
                "title": "Add Memory Record",
                "category": "HipCortex"
            },
            {
                "command": "hipcortex.queryMemory", 
                "title": "Query Memory Records",
                "category": "HipCortex"
            },
            {
                "command": "hipcortex.testExtension",
                "title": "Test HipCortex Extension",
                "category": "HipCortex"
            },
            {
                "command": "hipcortex.healthCheck",
                "title": "System Health Check",
                "category": "HipCortex"
            },
            {
                "command": "hipcortex.predictState",
                "title": "Predict Next State",
                "category": "HipCortex"
            }
        ],
        "chatParticipants": [
            {
                "id": "hipcortex",
                "name": "HipCortex",
                "description": "HipCortex AI Memory Assistant - Official Extension",
                "isSticky": true,
                "commands": [
                    {
                        "name": "add",
                        "description": "Add a new memory record"
                    },
                    {
                        "name": "query", 
                        "description": "Search memory records"
                    },
                    {
                        "name": "health",
                        "description": "Check system health"
                    },
                    {
                        "name": "help",
                        "description": "Show help information"
                    },
                    {
                        "name": "predict",
                        "description": "Predict next state using world-model"
                    },
                    {
                        "name": "coherence",
                        "description": "Check memory coherence"
                    }
                ]
            }
        ],
        "languageModelTools": [
            {
                "name": "hipcortex_search",
                "displayName": "HipCortex Memory Search",
                "description": "Search HipCortex persistent memory for relevant context. Returns the most relevant memory records matching the query.",
                "modelDescription": "Use this tool when you need to recall previous decisions, architectural choices, debugging notes, or any information that may have been stored in the user's persistent memory. Call this instead of asking the user to repeat information they have already provided.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "query": {
                            "type": "string",
                            "description": "What to search for in memory"
                        }
                    },
                    "required": ["query"]
                }
            },
            {
                "name": "hipcortex_health",
                "displayName": "HipCortex System Health",
                "description": "Check HipCortex system health including self-model, world-model, and coherence status.",
                "modelDescription": "Use this tool to check if the memory system is healthy before relying on it for critical decisions. Returns health scores for all modules.",
                "inputSchema": {
                    "type": "object",
                    "properties": {},
                    "required": []
                }
            },
            {
                "name": "hipcortex_predict",
                "displayName": "HipCortex State Prediction",
                "description": "Predict next state using the world-model's Dirichlet-Multinomial transition model.",
                "modelDescription": "Use this tool to ask the world-model what it expects to happen next given a current state and action.",
                "inputSchema": {
                    "type": "object",
                    "properties": {
                        "state": { "type": "string", "description": "Current state" },
                        "action": { "type": "string", "description": "Action being taken" }
                    },
                    "required": ["state", "action"]
                }
            }
        ],
        "configuration": {
            "title": "HipCortex Memory",
            "properties": {
                "hipcortex.apiUrl": {
                    "type": "string",
                    "default": "http://127.0.0.1:3030",
                    "description": "HipCortex API server URL"
                },
                "hipcortex.apiKey": {
                    "type": "string",
                    "default": "",
                    "description": "API key for authentication (if required)"
                },
                "hipcortex.autoStart": {
                    "type": "boolean",
                    "default": true,
                    "description": "Automatically start HipCortex server if not running"
                }
            }
        }
    },
    "activationEvents": [
        "onStartupFinished",
        "onCommand:workbench.action.chat.open"
    ],
    "scripts": {
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "package": "webpack --mode production --devtool hidden-source-map",
        "compile-tests": "tsc -p . --outDir out",
        "watch-tests": "tsc -p . -w --outDir out",
        "pretest": "npm run compile-tests && npm run compile && npm run lint",
        "lint": "eslint src --ext ts",
        "test": "node ./out/test/runTest.js"
    },
    "devDependencies": {
        "@types/vscode": "^1.90.0",
        "@types/node": "20.x",
        "@typescript-eslint/eslint-plugin": "^6.13.1",
        "@typescript-eslint/parser": "^6.13.1",
        "eslint": "^8.54.0",
        "typescript": "^5.3.2",
        "webpack": "^5.89.0",
        "webpack-cli": "^5.1.4",
        "ts-loader": "^9.5.1"
    },
    "dependencies": {
        "axios": "^1.6.2"
    }
}
