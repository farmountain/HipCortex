    {
      "id": "config:sdk/typescript/tsconfig.json",
      "type": "config",
      "label": "TypeScript SDK tsconfig.json",
      "file": "sdk/typescript/tsconfig.json",
      "tags": ["typescript", "compiler-config", "sdk"],
      "properties": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020"],
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": true,
        "excludes": ["node_modules", "dist", "**/*.test.ts"],
        "description": "TypeScript compiler config for the SDK. Targets ES2020/CommonJS, emits full declarations + source maps, strict mode on."
      }
    }
