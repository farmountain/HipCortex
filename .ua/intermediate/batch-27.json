      "properties": {
        "name": "hipcortex",
        "version": "0.5.2",
        "license": "Apache-2.0",
        "main": "dist/index.js",
        "types": "dist/index.d.ts",
        "registry": "https://registry.npmjs.org/",
        "repository": "https://github.com/farmountain/HipCortex.git",
        "scripts": {
          "build": "tsc",
          "test": "jest",
          "prepublishOnly": "npm run build"
        },
        "dev_dependencies": {
          "typescript": "^5.0.0",
          "jest": "^29.0.0",
          "ts-jest": "^29.0.0",
          "@types/node": "^20.0.0",
          "@types/jest": "^29.0.0"
        },
        "keywords": ["ai", "memory", "langchain", "autogen", "llm", "agents", "rag", "hipcortex"],
        "description": "npm package manifest for the hipcortex TypeScript SDK. Zero production dependencies; dev-only TypeScript + Jest toolchain. Publishes dist/ with declaration maps."
